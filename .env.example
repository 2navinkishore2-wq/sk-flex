# ============================================================
# SK FLEX BILLING — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in your values.
# Never commit the real `.env` file (it is git-ignored).
# ============================================================

# ---- Firebase (free "Spark" plan) ---------------------------------
# Create a free project at https://console.firebase.google.com
# 1. Add a Web App  ->  copy the config values shown there.
# 2. Authentication -> Sign-in method -> enable "Google".
# 3. Firestore Database -> Create database (production mode) ->
#    deploy the rules in /firebase/firestore.rules (see README).

# Web API key (public by design; protected by Firestore rules)
VITE_FIREBASE_API_KEY=

# e.g. your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# e.g. your-project-id
VITE_FIREBASE_PROJECT_ID=

# e.g. your-project.appspot.com
VITE_FIREBASE_STORAGE_BUCKET=

# 12-digit sender id from the Firebase console
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Web app id: 1:123456789:web:abcdef...
VITE_FIREBASE_APP_ID=

# ---- Data mode ----------------------------------------------------
# auto    -> use Firebase cloud if configured, otherwise demo mode
# cloud   -> force cloud (shows setup screen if not configured)
# local   -> force local demo mode (no cloud, data stays on device)
VITE_DATA_MODE=auto

# ---- Android native Google Sign-In ---------------------------------
# On Android (Capacitor), the app uses the native Credential Manager API
# instead of the JS SDK redirect flow, which is unreliable in the WebView.
# This is the Web OAuth client ID for your Firebase project (client_type 3).
# It is a PUBLIC value — embedded in the APK, not a secret. Find it in:
#   Firebase Console → Project Settings → General → Web apps → Web client ID
# or in Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
# Without this value, Android will fall back to the less reliable redirect flow.
VITE_GOOGLE_WEB_CLIENT_ID=

# NOTE: there is no VITE_AUTH_METHOD variable. The auth flow is chosen
# automatically by the app: Google popup on Web/Windows (Electron),
# native Credential Manager on Android (Capacitor), and a redirect fallback
# if the native path is unavailable or fails.

# ---- Local development ONLY (Firebase emulator) ----------------------
# Set this only for local emulator testing — NEVER in a production .env.
# Format: host:port (Firestore emulator port; Auth always uses 9099).
# The app honors this ONLY in dev builds (import.meta.env.DEV), so a
# production build can never connect to an emulator.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:8080