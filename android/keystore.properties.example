# Release signing configuration for the Android app.
# Copy this file to android/keystore.properties and fill in your values.
# NEVER commit keystore.properties or the keystore file itself — both are
# git-ignored. storeFile is relative to the android/ directory.
#
# Create the keystore once with (JDK keytool):
#   keytool -genkeypair -v -keystore release.keystore -alias skflex \
#     -keyalg RSA -keysize 2048 -validity 10000 -storepass <pass> -keypass <pass>
#
# Then register its SHA-1 / SHA-256 in the Firebase console (see README §7).
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=skflex
keyPassword=CHANGE_ME
